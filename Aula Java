       lblMsg.setText("Maior Valor do vetor: "+getMaiorValor());
    }                                        

    private void btnTotalActionPerformed(java.awt.event.ActionEvent evt) {                                        
       lblMsg.setText("Total: "+getTotal());
    }                                        

    private void btnMediaActionPerformed(java.awt.event.ActionEvent evt) {                                        
        lblMsg.setText("Media: "+getMedia());
    }                                        
