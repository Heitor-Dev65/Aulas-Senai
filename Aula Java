double[] valores = new double[10];
  int quantidade = 0;
 
  public double Somar(double a, double b){
      return a + b;
  }
 
  public double Subtrair(double a, double b){
      return a - b;
  }
 
  public double Dividir(double a, double b){
      return a / b;
  }
 
  public double Multiplicar(double a, double b){
      return a * b;
  }
 
    public void Add(double valor){
        for(int i = 0; i < 10; i++){
            if(valores[i] == 0){
                valores[i] = valor;
                quantidade++;
                break;
            }
        }
    }
   

   
    public double getMaiorValor(){
        double maior = 0;
        for(int i = 0; i < quantidade; i++){
            if(valores[i] > maior){
                maior = valores[i];
            }
        }
        return maior;
    }
   
    public double getMenorValor(){
        double menor = valores[0];
        for(int i = 0; i < quantidade; i++){
            if(valores[i] < menor){
                menor = valores[i];                
            }
        }
        return menor;
    }
   
    public double getTotal(){
        double soma = 0;
        for(int i = 0; i < quantidade; i++){
            soma += valores[i];
            //soma = soma + valores[i];
        }
        return soma;
    }
   
    public double getMedia(){
        return getTotal() / quantidade;
    }
 
   
    private void btnAddActionPerformed(java.awt.event.ActionEvent evt) {                                      
        double valor01 = Double.parseDouble(txtValor01.getText());
        double valor02 = Double.parseDouble(txtValor02.getText());
       
        int op = cbOperador.getSelectedIndex();
        switch(op){
            case 0:
                Add(Somar(valor01, valor02));
                break;
               
            case 1:
                Add(Subtrair(valor01, valor02));
                break;
           
            case 2:
                Add(Dividir(valor01, valor02));
                break;
           
            case 3:
                Add(Multiplicar(valor01, valor02));
                break;                                        
        }
    }                                      

