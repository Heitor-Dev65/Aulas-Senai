CREATE DATABASE ATIVIDADE22;

USE ATIVIDADE22;

CREATE TABLE LOCADORA(
	ID INT NOT NULL auto_increment PRIMARY KEY,
    NOME VARCHAR(100) NOT NULL,
    CEP BIGINT NOT NULL UNIQUE,
    CNPJ BIGINT NOT NULL UNIQUE
);

CREATE TABLE CLIENTE(
	ID INT NOT NULL auto_increment PRIMARY KEY,
    NOME VARCHAR(100) NOT NULL,
    DATA_NASC DATETIME NULL DEFAULT NOW(),
    SEXO CHAR(1) NULL DEFAULT 'F',
    SALDO BIGINT NOT NULL UNIQUE,
	CODIGO BIGINT NOT NULL UNIQUE,
    BONUS BIGINT NOT NULL UNIQUE
);

CREATE TABLE DEPENDENTE(
	ID INT NOT NULL auto_increment PRIMARY KEY,
	ID_CLIENTE INT NOT NULL,
    NOME VARCHAR(100) NOT NULL,
    SEXO CHAR(1) NULL DEFAULT 'F',
	DATA_NASC DATETIME NULL DEFAULT NOW(),
    CONSTRAINT FK_DEPENDENTE_CLIENTE FOREIGN KEY(ID_CLIENTE) REFERENCES CLIENTE(ID)
);

CREATE TABLE BONUS(
	ID INT NOT NULL auto_increment PRIMARY KEY,
    ID_CLIENTE INT NOT NULL,
    MARCA_TEXTO CHAR(1) NULL DEFAULT '0',
    QUANT_LIVROS VARCHAR(100) NOT NULL,
    BENEFICIO_TEMPO VARCHAR(100) NOT NULL,
    CONSTRAINT FK_BONUS_CLIENTE FOREIGN KEY(ID_CLIENTE) REFERENCES CLIENTE(ID)
);

CREATE TABLE LIVRO_BONUS(
	ID INT NOT NULL auto_increment PRIMARY KEY,
    ID_BONUS INT NOT NULL,
    LIVRO_BONUS VARCHAR(100) NOT NULL,
    CONSTRAINT FK_LIVRO_BONUS_CLIENTE FOREIGN KEY(ID_BONUS) REFERENCES BONUS(ID)
);

CREATE TABLE FUNCIONARIO(
	ID INT NOT NULL auto_increment PRIMARY KEY,
    ID_LOCADORA INT NOT NULL,
    NOME VARCHAR(100) NOT NULL,
    SEXO CHAR(1) NULL DEFAULT 'F',
    DATA_NASC DATETIME NULL DEFAULT NOW(),
    SETOR VARCHAR(50) NOT NULL,
    ENDEREÇO BIGINT NOT NULL,
    DATA_ADMISSAO BIGINT NOT NULL,
	CONSTRAINT FK_FUNCIONARIO_LOCADORA FOREIGN KEY(ID_LOCADORA) REFERENCES LOCADORA(ID)
);

CREATE TABLE LIVROS(
	ID INT NOT NULL auto_increment PRIMARY KEY,
    AUTOR VARCHAR(100) NOT NULL,
    ISBN  CHAR(12) NULL DEFAULT '0' UNIQUE,
    ANO_LANÇAMENTO DATETIME NOT NULL,
    TITULO VARCHAR(100) NOT NULL,
    EDITORA VARCHAR(50) NOT NULL,
    GENERO CHAR(1) NULL DEFAULT 'F',
    PREÇO BIGINT NOT NULL,
    QUANTIDADE BIGINT NOT NULL
);

CREATE TABLE EMPRESTIMO(
	ID INT NOT NULL auto_increment PRIMARY KEY,
    ID_CLIENTE INT NOT NULL,
    DATA_EMPRESTIMO DATETIME NULL DEFAULT NOW(),
    QUANTIDADE SMALLINT NOT NULL,
    CONSTRAINT FK_EMPRESTIMO_CLIENTE FOREIGN KEY(ID_CLIENTE) REFERENCES CLIENTE(ID)
);

CREATE TABLE DEVOLUCAO(
	ID INT NOT NULL auto_increment PRIMARY KEY,
    ID_CLIENTE INT NOT NULL,
    DATA_DEVOLUCAO DATETIME NULL DEFAULT NOW(),
    JUROS_ATRASO VARCHAR(100) NOT NULL,
    QUANTIDADE BIGINT NOT NULL,
    CONSTRAINT FK_DEVOLUCAO_CLIENTE FOREIGN KEY(ID_CLIENTE) REFERENCES CLIENTE(ID)
);
