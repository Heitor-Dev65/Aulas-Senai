void addNumero() {
    for (int i = 0; i < 2; i++) {
            cout<<"Informe um numero ao vetor"<<endl;
            cin>>numeros[i];
    }
}

void exibirNumeros() {
    for (int i = 0; i < 2; i++) {
        cout<<"Numeros adicionados: "<<numeros[i]<<endl;

    }
}

void somaNumeros() {
    for (int i = 0; i < 2; i++) {
        calculo = numeros[i] + numeros[i];
        cout<<"Soma dos numeros add"<<calculo<<endl;
    }
}

void mediaNum() {

    int  mediaNumm;
    cout<<"Exibir a media"<<endl;
    for (int i = 0; i < 2; i++){
        if (numeros[i] > 0) {
        mediaNumm = numeros[i] / 2;
            cout<<"media: "<<mediaNumm<<endl;

        }
    }
}


void maiorNum() {
    for (int i = 0; i < 2; i++) {
        if (numeros[i] > numero) {
            cout<<"O maior numero e: "<<numeros[i]<<endl;
        }
    }
}


void menorNum() {
    for (int i = 0; i < 2; i++) {
        if (numeros[i] < numero) {
            cout<<"O menor numero e: "<<numeros[i]<<endl;
        }
    }
}

void numPares() {
    for (int i = 0; i < 2; i++){
    if (numeros[i] / 2) {
